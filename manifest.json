{
  "manifest_version": 3,
  "name": "HTML \u6ce8\u5165\u5668",
  "version": "1.0.5",
  "description": "\u5728\u7f51\u9875 head \u4e2d\u63d2\u5165\u81ea\u5b9a\u4e49 HTML \u4ee3\u7801\uff0c\u652f\u6301\u5168\u5c40\u5f00\u5173\u548c\u6301\u4e45\u5b58\u50a8\uff0c\u65e0\u9700\u5728\u6bcf\u4e2a\u7f51\u7ad9\u91cd\u65b0\u914d\u7f6e",
  "permissions": [
    "storage",
    "notifications",
    "scripting",
    "tabs",
    "alarms",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "csp_rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "incognito": "split"
}
